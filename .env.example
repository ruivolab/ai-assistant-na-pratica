# Copie para .env e preencha. O .env nunca vai para o git.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_EFFORT=low
ASSISTANT_MESSAGES_PER_HOUR=30

# Outro provedor compatível com a API da Anthropic (ex.: OpenRouter): deixe ANTHROPIC_API_KEY vazia e use
# ANTHROPIC_BASE_URL=https://openrouter.ai/api
# ANTHROPIC_AUTH_TOKEN=
# ASSISTANT_MODEL=<o id do modelo no provedor>
# ASSISTANT_EFFORT=
# ASSISTANT_FALLBACK=0

# Só para o deploy (compose.prod.yaml):
DOMAIN=loja.seudominio.com.br
